// TK Shop 定价计算器 — 数据模型
// 修改后执行：pnpm db:migrate --name <change>（会自动 generate）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// 店铺：一个站点上的一家店，持有全部费率/物流/定价配置
// ============================================
model Shop {
  id   String @id @default(uuid())
  name String @db.VarChar(100)
  /// 站点代码：MY / TH / PH / VN / SG / ID
  site String @db.VarChar(8)

  /// 店铺配置（费用行、物流、退货、定价目标），结构见 src/domain/shop-config.ts
  config   Json
  /// 创建时所基于的预设 id，仅作溯源
  presetId String? @map("preset_id") @db.VarChar(60)

  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("shops")
}

// ============================================
// 商品
// ============================================
model Product {
  id String @id @default(uuid())

  shopId String @map("shop_id")
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  name        String  @default("") @db.VarChar(255)
  url         String? @db.Text
  description String? @db.Text
  imageUrl    String? @map("image_url") @db.Text
  /// 类目名称（自由文本），便于按类目设置佣金与筛选
  category    String? @db.VarChar(100)
  /// 商品级佣金率，覆盖店铺的 commission 费用行；null = 继承
  commissionRate Decimal? @map("commission_rate") @db.Decimal(10, 4)

  isExpanded   Boolean @default(true) @map("is_expanded")
  displayOrder Int     @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  variants SKU[]

  @@index([shopId, displayOrder])
  @@map("products")
}

// ============================================
// SKU 变体
// ============================================
model SKU {
  id String @id @default(uuid())

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  skuName      String   @default("") @map("sku_name") @db.VarChar(255)
  skuCode      String?  @map("sku_code") @db.VarChar(100)
  tiktokSkuId  String?  @map("tiktok_sku_id") @db.VarChar(50)
  imageUrl     String?  @map("image_url") @db.Text
  currentPrice Decimal? @map("current_price") @db.Decimal(12, 2)
  inventory    Int?     @map("inventory")

  // 成本（成本币种，通常 CNY）
  purchaseCost     Decimal @default(0) @map("purchase_cost") @db.Decimal(10, 2)
  domesticShipping Decimal @default(0) @map("domestic_shipping") @db.Decimal(10, 2)
  packagingFee     Decimal @default(0) @map("packaging_fee") @db.Decimal(10, 2)

  // 包裹（含包装）
  weight   Decimal  @default(0) @db.Decimal(10, 3)
  lengthCm Decimal? @map("length_cm") @db.Decimal(8, 1)
  widthCm  Decimal? @map("width_cm") @db.Decimal(8, 1)
  heightCm Decimal? @map("height_cm") @db.Decimal(8, 1)

  // 覆盖设置：null = 继承店铺
  returnRate      Decimal? @map("return_rate") @db.Decimal(10, 4)
  finalPrice      Decimal? @map("final_price") @db.Decimal(12, 2)
  pricingStrategy String?  @map("pricing_strategy") @db.VarChar(20)
  /// 自定义策略的目标净利率
  customMargin    Decimal? @map("custom_margin") @db.Decimal(10, 4)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@map("sku_variants")
}
