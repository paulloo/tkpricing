# PostgreSQL 连接串（必填）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tk_pricing?schema=public"

# 集成测试数据库（可选）。不设置时使用 DATABASE_URL 的库名加 _test，测试会清空该库。
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tk_pricing_test?schema=public"

# HTTP Basic 认证（可选）。部署到公网时务必设置。
# BASIC_AUTH_USER="admin"
# BASIC_AUTH_PASSWORD="change-me"
